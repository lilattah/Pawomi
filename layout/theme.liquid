<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title><meta name="theme-color" content="{{ settings.brand_red }}">{{ content_for_header }}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Nunito+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet"><style>:root{--red:{{ settings.brand_red | default: '#CD071B' }};--cream:{{ settings.brand_cream | default: '#FFF4D6' }};--ink:{{ settings.brand_ink | default: '#161616' }}}</style>{{ 'pawomi.css' | asset_url | stylesheet_tag }}<script src="{{ 'pawomi.js' | asset_url }}" defer></script><script src="{{ 'pawomi-chase.js' | asset_url }}" defer></script><style>:root{--pawomi-cursor-asset:url('{{ 'pawomi-cursors.png' | asset_url }}')}</style><script src="{{ 'pawomi-cursor.js' | asset_url }}" defer></script></head><body><a href="#main" class="skip">İçeriğe geç</a>{% sections 'header-group' %}<main id="main" role="main">{{ content_for_layout }}</main>{% sections 'footer-group' %}</body></html>