<article class="product-card">{% if featured_slider %}<button class="product-favorite" type="button" data-favorite-product="{{ product.handle | escape }}" aria-label="{{ product.title | escape }} favorilere ekle" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.3 5.3 0 0 0-7.5 0L12 6l-1.3-1.4a5.3 5.3 0 0 0-7.5 7.5L12 21l8.8-8.9a5.3 5.3 0 0 0 0-7.5z"/></svg></button>{% endif %}<a href="{{ product.url }}" class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span class="placeholder-icon">🐾</span>{% endif %}</a><div class="product-info"><a href="{{ product.url }}" class="product-name">{{ product.title | escape }}</a>{% if featured_slider %}<div class="product-bottom">{% endif %}<div class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% if product.available %}{% form 'product', product, class: 'product-mini-form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% if featured_slider %}<button type="submit" class="product-cart" aria-label="{{ product.title | escape }} sepete ekle"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="8" width="14" height="13" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/><path d="M12 12v5m-2.5-2.5h5"/></svg></button>{% else %}<button type="submit" class="btn small">♡ Sepete Ekle</button>{% endif %}{% endform %}{% else %}<span class="muted">Tükendi</span>{% endif %}{% if featured_slider %}</div>{% endif %}</div></article>