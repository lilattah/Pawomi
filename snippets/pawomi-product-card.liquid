<article class="product-card"><a href="{{ product.url }}" class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span class="placeholder-icon">🐾</span>{% endif %}</a><div class="product-info"><a href="{{ product.url }}" class="product-name">{{ product.title | escape }}</a><div class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% if product.available %}{% form 'product', product, class: 'product-mini-form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit" class="btn small">♡ Sepete Ekle</button>{% endform %}{% else %}<span class="muted">Tükendi</span>{% endif %}</div></article>