<section id="story" class="wrap section-pad pawomi-story-section"><div class="pawomi-story-banner"><div class="pawomi-story-copy"><h2>{{ section.settings.heading | newline_to_br }}</h2><a class="btn pawomi-story-cta" href="{{ section.settings.link | default: '/pages/hikayemiz' }}">{{ section.settings.button }} <span aria-hidden="true">→</span></a></div><div class="pawomi-story-illustration" aria-hidden="true"><img class="story-embrace" src="{{ 'story-embrace.png' | asset_url }}" alt="Kadının köpek ve kediye sarılması" loading="lazy"><span class="story-heart heart-one">♡</span><span class="story-heart heart-two">♡</span></div><div class="pawomi-story-description" id="story-details"><p>{{ section.settings.body }}</p></div></div></section>{% schema %}{"name":"Pawomi hikâye bannerı","settings":[{"type":"textarea","id":"heading","label":"Başlık","default":"Küçük\nDetaylar\nBüyük Mutluluklar"},{"type":"text","id":"body","label":"Açıklama","default":"Pawomi, patili dostlarımızın daha sağlıklı, daha mutlu ve daha keyifli bir yaşam sürmesi için var."},{"type":"text","id":"button","label":"Buton metni","default":"Hikâyemizi Keşfet"},{"type":"url","id":"link","label":"Bağlantı"}],"presets":[{"name":"Pawomi hikâye bannerı"}]}{% endschema %}