<section class="wrap section-pad"><div class="newsletter"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.body }}</p>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="sr" for="newsletterEmail">E-posta adresi</label><input id="newsletterEmail" type="email" name="contact[email]" placeholder="E-posta adresiniz" required><button class="btn" type="submit">Kaydol →</button>{% if form.posted_successfully? %}<p>Teşekkürler, kayıt alındı!</p>{% endif %}{% if form.errors %}{{ form.errors | default_errors }}{% endif %}{% endform %}</div><span class="news-emoji">🐶 ♡ 🐱</span></div></section>{% schema %}{"name":"Pawomi e-bülten","settings":[{"type":"text","id":"heading","label":"Başlık","default":"Pawomi Ailesine Katılın!"},{"type":"text","id":"body","label":"Açıklama","default":"Yeni ürünlerden ve patili haberlerden ilk sen haberdar ol."}],"presets":[{"name":"Pawomi e-bülten"}]}{% endschema %}