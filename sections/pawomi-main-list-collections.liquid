<section class="wrap section-pad"><h1>Koleksiyonlarımız</h1><div class="blog-grid">{% for collection in collections %}<a class="blog-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% else %}<div class="placeholder-icon">🐾</div>{% endif %}<div><h2>{{ collection.title }}</h2><span>Ürünleri keşfet →</span></div></a>{% endfor %}</div></section>{% schema %}{"name":"Pawomi koleksiyon listesi","settings":[]}{% endschema %}