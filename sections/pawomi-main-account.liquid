<section class="wrap section-pad"><div class="page-heading"><p class="pawomi-page-eyebrow">PAWOMI / HESABIM</p><h1>Hesabım ve Siparişlerim</h1><p>Patili alışverişlerini buradan takip edebilirsin.</p></div>{% if customer %}<div class="catalog"><aside class="filter-box"><h3>Hesabım</h3><a href="{{ routes.account_url }}">Siparişlerim</a><a href="{{ routes.account_addresses_url }}">Adreslerim</a><a href="/pages/favorilerim">Favorilerim</a><a href="{{ routes.account_logout_url }}">Çıkış Yap</a></aside><div><h2>Merhaba {{ customer.first_name | escape }} ♡</h2><div class="cart-list">{% paginate customer.orders by 10 %}{% for order in customer.orders %}<div class="cart-item"><div><b>{{ order.name }}</b><p>{{ order.created_at | date: '%d.%m.%Y' }}</p></div><span>{{ order.financial_status_label }}</span><span>{{ order.fulfillment_status_label }}</span><strong>{{ order.total_price | money }}</strong><a href="{{ order.customer_url }}">Detay →</a></div>{% else %}<p>Henüz siparişin yok.</p>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></div></div>{% else %}<div class="pawomi-soft-card"><p>Hesabına giriş yaparak siparişlerini görüntüleyebilirsin.</p><a class="btn" href="{{ routes.account_login_url }}">Giriş Yap →</a></div>{% endif %}</section>{% schema %}{"name":"Pawomi hesap ve siparişler","settings":[]}{% endschema %}