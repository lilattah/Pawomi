<section class="wrap section-pad"><div class="promo promo-adventure" style="--promo-bg:{{ section.settings.background }}"><div><p class="eyebrow">PAWOMI KOLEKSİYONLARI</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.body }}</p><a class="btn" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.button }} →</a></div><div class="promo-photo promo-adventure-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}<img class="promo-dog" src="{{ 'pawomi-dog.png' | asset_url }}" alt="Neşeli köpek" loading="lazy"><img class="promo-cat" src="{{ 'pawomi-cat.png' | asset_url }}" alt="Neşeli kedi" loading="lazy"><span class="promo-sun" aria-hidden="true">☀</span>{% endif %}</div></div></section>{% schema %}{"name":"Pawomi kampanya banner","settings":[{"type":"text","id":"heading","label":"Başlık","default":"Her Macera Daha Güzel"},{"type":"textarea","id":"body","label":"Metin","default":"Patili dostların her anına eşlik eden ürünler."},{"type":"text","id":"button","label":"Buton","default":"Koleksiyonu Keşfet"},{"type":"url","id":"link","label":"Bağlantı"},{"type":"image_picker","id":"image","label":"Görsel"},{"type":"color","id":"background","label":"Arka plan","default":"#FFE08A"}],"presets":[{"name":"Pawomi kampanya banner"}]}{% endschema %}