<section class="wrap section-pad"><div class="promo promo-adventure" style="--promo-bg:{{ section.settings.background }}"><div><p class="eyebrow">PAWOMI KOLEKSİYONLARI</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.body }}</p><a class="btn" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.button }} →</a></div><div class="promo-photo promo-adventure-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy' }}{% else %}<img class="promo-photo-real" src="{{ 'sky-friends.png' | asset_url }}" alt="Gökyüzüne bakan köpek ve kedi" loading="lazy">{% endif %}</div></div><div class="promo-floating-assets" aria-hidden="true"><img class="promo-float-decor promo-decor-1" src="{{ 'promo-decor-1.png' | asset_url }}" alt="" aria-hidden="true" loading="lazy"><img class="promo-float-decor promo-decor-2" src="{{ 'promo-decor-2.png' | asset_url }}" alt="" aria-hidden="true" loading="lazy"><img class="promo-float-decor promo-decor-3" src="{{ 'promo-decor-3.png' | asset_url }}" alt="" aria-hidden="true" loading="lazy"><img class="promo-float-decor promo-decor-4" src="{{ 'promo-decor-4.png' | asset_url }}" alt="" aria-hidden="true" loading="lazy"><img class="promo-float-decor promo-decor-5" src="{{ 'promo-decor-5.png' | asset_url }}" alt="" aria-hidden="true" loading="lazy"></div></section>{% schema %}{"name":"Pawomi kampanya banner","settings":[{"type":"text","id":"heading","label":"Başlık","default":"Her Macera Daha Güzel"},{"type":"textarea","id":"body","label":"Metin","default":"Patili dostların her anına eşlik eden ürünler."},{"type":"text","id":"button","label":"Buton","default":"Koleksiyonu Keşfet"},{"type":"url","id":"link","label":"Bağlantı"},{"type":"image_picker","id":"image","label":"Görsel"},{"type":"color","id":"background","label":"Arka plan","default":"#FFE08A"}],"presets":[{"name":"Pawomi kampanya banner"}]}{% endschema %}