<section class="wrap section-pad"><div class="category-row">{% for block in section.blocks %}<a class="category" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}><span class="cat-icon">{% if block.settings.image %}{{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% else %}{% assign icon_name = '' %}{% case block.settings.label %}{% when 'Mama' %}{% assign icon_name = 'icon-mama.png' %}{% when 'Tasma & Kayış' %}{% assign icon_name = 'icon-tasma.png' %}{% when 'Oyuncak' %}{% assign icon_name = 'icon-oyuncak.png' %}{% when 'Bakım' %}{% assign icon_name = 'icon-bakim.png' %}{% when 'Yatak & Ev' %}{% assign icon_name = 'icon-yatak.png' %}{% when 'Sağlık' %}{% assign icon_name = 'icon-saglik.png' %}{% endcase %}{% if icon_name != blank %}<img src="{{ icon_name | asset_url }}" alt="" width="88" height="88" loading="lazy">{% else %}{{ block.settings.emoji }}{% endif %}{% endif %}</span><b>{{ block.settings.label }}</b></a>{% endfor %}</div></section>{% schema %}{"name":"Pawomi kategoriler","blocks":[{"type":"category","name":"Kategori","settings":[{"type":"text","id":"label","label":"Başlık"},{"type":"text","id":"emoji","label":"Geçici ikon"},{"type":"image_picker","id":"image","label":"Görsel"},{"type":"url","id":"link","label":"Bağlantı"}]}],"presets":[{"name":"Pawomi kategoriler","blocks":[{"type":"category","settings":{"label":"Mama","emoji":"🥣"}},{"type":"category","settings":{"label":"Tasma & Kayış","emoji":"🦮"}},{"type":"category","settings":{"label":"Oyuncak","emoji":"🧶"}},{"type":"category","settings":{"label":"Bakım","emoji":"🪮"}},{"type":"category","settings":{"label":"Yatak & Ev","emoji":"🛏️"}},{"type":"category","settings":{"label":"Sağlık","emoji":"🐾"}}]}]}{% endschema %}