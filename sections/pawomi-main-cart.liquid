<section class="wrap section-pad"><div class="page-heading"><h1>Sepetim ♡</h1><p>Patili mutluluklar burada birikiyor!</p></div>{% if cart.item_count == 0 %}<div class="empty-state"><span>🐾</span><h2>Sepetin henüz boş</h2><a href="/collections/all" class="btn">Ürünleri Keşfet</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-list">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}"><b>{{ item.product.title }}</b></a><p>{{ item.variant.title }}</p><span>{{ item.final_line_price | money }}</span></div><label>Adet<input name="updates[]" type="number" min="0" value="{{ item.quantity }}"></label><a href="{{ item.url_to_remove }}">Kaldır</a></div>{% endfor %}</div><div class="cart-summary"><p class="pawomi-page-eyebrow">SİPARİŞ ÖZETİ</p><h2>Toplam: {{ cart.total_price | money }}</h2><button type="submit" name="update" class="btn light-btn">Sepeti Güncelle</button><button type="submit" name="checkout" class="btn">Güvenli Ödemeye Geç →</button></div></form>{% endif %}</section>{% schema %}{"name":"Pawomi sepet","settings":[]}{% endschema %}