<section class="wrap section-pad featured-products"><div class="section-heading"><h2>{{ section.settings.heading }}</h2><div class="featured-carousel-controls"><a href="{{ section.settings.collection.url | default: '/collections/all' }}">Tüm Ürünleri Gör</a><button type="button" class="featured-carousel-arrow" data-slide="-1" aria-label="Önceki ürünler">‹</button><button type="button" class="featured-carousel-arrow" data-slide="1" aria-label="Sonraki ürünler">›</button></div></div><div class="featured-carousel" tabindex="0" aria-label="Öne çıkan ürünler"><div class="product-grid">{% assign featured = section.settings.collection %}{% if featured != blank and featured.products_count > 0 %}{% for product in featured.products limit: section.settings.count %}{% render 'pawomi-product-card', product: product, featured_slider: true %}{% endfor %}{% else %}<article class="product-card"><div class="product-photo"><img src="{{ 'product-harness.png' | asset_url }}" alt="Kırmızı P Detaylı Köpek Göğüs Tasması" loading="lazy"></div><div class="product-info"><span class="product-name">Kırmızı P Detaylı Köpek Göğüs Tasması</span><span class="muted">Örnek ürün – fiyat Shopify'da tanımlanır</span></div></article><article class="product-card"><div class="product-photo"><img src="{{ 'product-leash.png' | asset_url }}" alt="Yeşil Halat Köpek Gezdirme Kayışı" loading="lazy"></div><div class="product-info"><span class="product-name">Yeşil Halat Köpek Gezdirme Kayışı</span><span class="muted">Örnek ürün – fiyat Shopify'da tanımlanır</span></div></article><article class="product-card"><div class="product-photo"><img src="{{ 'product-duck.png' | asset_url }}" alt="Peluş Ördek Oyuncak" loading="lazy"></div><div class="product-info"><span class="product-name">Peluş Ördek Oyuncak</span><span class="muted">Örnek ürün – fiyat Shopify'da tanımlanır</span></div></article><article class="product-card"><div class="product-photo"><img src="{{ 'product-bed.png' | asset_url }}" alt="Adaçayı Yeşili Peluş Yatak" loading="lazy"></div><div class="product-info"><span class="product-name">Adaçayı Yeşili Peluş Yatak</span><span class="muted">Örnek ürün – fiyat Shopify'da tanımlanır</span></div></article><article class="product-card"><div class="product-photo"><img src="{{ 'product-bowl.png' | asset_url }}" alt="Pawomi Mama ve Su Kabı" loading="lazy"></div><div class="product-info"><span class="product-name">Pawomi Mama ve Su Kabı</span><span class="muted">Örnek ürün – fiyat Shopify'da tanımlanır</span></div></article>{% endif %}</div></div></section>{% schema %}{"name":"Pawomi öne çıkan ürünler","settings":[{"type":"text","id":"heading","label":"Başlık","default":"Öne Çıkan Ürünler"},{"type":"collection","id":"collection","label":"Ürün koleksiyonu"},{"type":"range","id":"count","label":"Ürün sayısı","min":2,"max":12,"step":1,"default":8}],"presets":[{"name":"Pawomi öne çıkan ürünler"}]}{% endschema %}