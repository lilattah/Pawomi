<section class="wrap section-pad featured-products"><div class="section-heading"><h2>{{ section.settings.heading }}</h2><div class="featured-carousel-controls"><a href="{{ section.settings.collection.url | default: '/collections/all' }}">Tüm Ürünleri Gör</a><button type="button" class="featured-carousel-arrow" data-slide="-1" aria-label="Önceki ürünler">‹</button><button type="button" class="featured-carousel-arrow" data-slide="1" aria-label="Sonraki ürünler">›</button></div></div><div class="featured-carousel" tabindex="0" aria-label="Öne çıkan ürünler"><div class="product-grid">{% assign featured = section.settings.collection %}{% if featured != blank and featured.products_count > 0 %}{% for product in featured.products limit: section.settings.count %}{% render 'pawomi-product-card', product: product, featured_slider: true %}{% endfor %}{% else %}{% for i in (1..4) %}<div class="product-card"><div class="product-photo placeholder-icon">{% cycle '🦮','🧶','🐕','🛏️' %}</div><div class="product-info"><b>Örnek ürün {{ i }}</b><p>Ürünlerinizi Shopify'dan ekleyin</p><span class="btn small">Yakında</span></div></div>{% endfor %}{% endif %}</div></div></section>{% schema %}{"name":"Pawomi öne çıkan ürünler","settings":[{"type":"text","id":"heading","label":"Başlık","default":"Öne Çıkan Ürünler"},{"type":"collection","id":"collection","label":"Ürün koleksiyonu"},{"type":"range","id":"count","label":"Ürün sayısı","min":2,"max":12,"step":1,"default":8}],"presets":[{"name":"Pawomi öne çıkan ürünler"}]}{% endschema %}