<section class="wrap section-pad"><div class="section-heading"><h2>{{ section.settings.heading }}</h2><a href="{{ section.settings.collection.url | default: '/collections/all' }}">Tüm Ürünler →</a></div><div class="product-grid">{% assign featured = section.settings.collection %}{% if featured != blank and featured.products_count > 0 %}{% for product in featured.products limit: section.settings.count %}{% render 'pawomi-product-card', product: product %}{% endfor %}{% else %}{% for i in (1..4) %}<div class="product-card"><div class="product-photo placeholder-icon">{% cycle '🦮','🧶','🐕','🛏️' %}</div><div class="product-info"><b>Örnek ürün {{ i }}</b><p>Ürünlerinizi Shopify'dan ekleyin</p><span class="btn small">Yakında</span></div></div>{% endfor %}{% endif %}</div></section>{% schema %}{"name":"Pawomi öne çıkan ürünler","settings":[{"type":"text","id":"heading","label":"Başlık","default":"Öne Çıkan Ürünler"},{"type":"collection","id":"collection","label":"Ürün koleksiyonu"},{"type":"range","id":"count","label":"Ürün sayısı","min":2,"max":12,"step":1,"default":4}],"presets":[{"name":"Pawomi öne çıkan ürünler"}]}{% endschema %}