<section class="wrap section-pad"><div class="page-heading"><p class="eyebrow">PAWOMI / KOLEKSİYONLAR</p><h1>{{ collection.title | default: 'Tüm Ürünler' }}</h1><div class="rte">{{ collection.description }}</div></div><div class="catalog"><aside class="filter-box"><h3>Koleksiyonlar</h3>{% for c in collections limit: 12 %}<a href="{{ c.url }}">{{ c.title }}</a>{% endfor %}<hr><h3>Filtrele</h3><form id="filterForm" method="get">{% for filter in collection.filters %}<details open><summary>{{ filter.label }}</summary>{% for value in filter.values %}<label class="filter-check"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>{{ value.label }} ({{ value.count }})</label>{% endfor %}</details>{% endfor %}<button class="btn small" type="submit">Uygula</button></form></aside><div><div class="catalog-toolbar"><span>{{ collection.products_count }} ürün</span><form method="get"><label for="sortBy">Sıralama</label><select id="sortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>{% paginate collection.products by 12 %}<div class="product-grid">{% for product in collection.products %}{% render 'pawomi-product-card', product: product %}{% else %}<p>Bu koleksiyonda henüz ürün yok.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></div></section>{% schema %}{"name":"Pawomi koleksiyon kataloğu","settings":[]}{% endschema %}