<section class="wrap section-pad">{% if collection.handle == "kopek" or collection.handle == "kedi" or collection.handle == "kampanya" %}<div class="pawomi-category-hero {% if collection.handle == "kopek" %}pawomi-category-hero--dog{% elsif collection.handle == "kedi" %}pawomi-category-hero--cat{% else %}pawomi-category-hero--campaign{% endif %}"><div><p class="pawomi-page-eyebrow">PAWOMI / KOLEKSİYONLAR</p><h1>{{ collection.title }}</h1><p>{{ collection.description | strip_html | truncate: 180 }}</p></div>{% if collection.image %}{{ collection.image | image_url: width: 850 | image_tag: loading: "lazy" }}{% elsif collection.handle == "kopek" %}<img src="{{ 'pawomi-dog.png' | asset_url }}" alt="Köpek koleksiyonu" loading="lazy">{% elsif collection.handle == "kedi" %}<img src="{{ 'pawomi-cat.png' | asset_url }}" alt="Kedi koleksiyonu" loading="lazy">{% else %}<img src="{{ 'discount-dog.png' | asset_url }}" alt="Pawomi kampanya" loading="lazy">{% endif %}</div>{% endif %><div class="page-heading"><p class="eyebrow">PAWOMI / KOLEKSİYONLAR</p><h1>{{ collection.title | default: 'Tüm Ürünler' }}</h1><div class="rte">{{ collection.description }}</div></div><div class="catalog"><aside class="filter-box"><h3>Koleksiyonlar</h3>{% for c in collections limit: 12 %}<a href="{{ c.url }}">{{ c.title }}</a>{% endfor %}<hr><h3>Filtrele</h3><form id="filterForm" method="get">{% for filter in collection.filters %}<details open><summary>{{ filter.label }}</summary>{% for value in filter.values %}<label class="filter-check"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>{{ value.label }} ({{ value.count }})</label>{% endfor %}</details>{% endfor %}<button class="btn small" type="submit">Uygula</button></form></aside><div><div class="catalog-toolbar"><span>{{ collection.products_count }} ürün</span><form method="get"><label for="sortBy">Sıralama</label><select id="sortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>{% paginate collection.products by 12 %}<div class="product-grid">{% for product in collection.products %}{% render 'pawomi-product-card', product: product %}{% else %}<p>Bu koleksiyonda henüz ürün yok.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></div></section>{% schema %}{"name":"Pawomi koleksiyon kataloğu","settings":[]}{% endschema %}