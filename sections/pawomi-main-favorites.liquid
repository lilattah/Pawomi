<section class="wrap section-pad"><div class="page-heading"><p class="pawomi-page-eyebrow">PAWOMI / FAVORİLERİM</p><h1>Favori Ürünlerim ♡</h1><p>Sevdiğin ürünler burada, seni bekliyor.</p></div><div class="product-grid" data-pawomi-favorites></div><div class="empty-state" data-favorites-empty><span>♡</span><h2>Henüz bir favorin yok</h2><a class="btn" href="/collections/all">Ürünleri Keşfet →</a></div></section>
<script>document.addEventListener('DOMContentLoaded',async()=>{const keys=Object.keys(localStorage).filter(k=>k==='pawomi-favorites');let items=[];try{items=JSON.parse(localStorage.getItem('pawomi-favorites')||'[]')}catch{}const holder=document.querySelector('[data-pawomi-favorites]');if(!holder)return;const products=await Promise.all(items.map(async handle=>{try{const r=await fetch('/products/'+encodeURIComponent(handle)+'.js');if(!r.ok)return null;return await r.json()}catch{return null}}));products.filter(Boolean).forEach(p=>{const art=document.createElement('article');art.className='product-card';const a=document.createElement('a');a.className='product-photo';a.href='/products/'+encodeURIComponent(p.handle);if(p.featured_image){const img=document.createElement('img');img.src=p.featured_image;img.alt=p.title;a.append(img)}const info=document.createElement('div');info.className='product-info';const title=document.createElement('a');title.className='product-name';title.href=a.href;title.textContent=p.title;info.append(title);const price=document.createElement('div');price.className='price';price.textContent=(p.price/100).toLocaleString('tr-TR',{style:'currency',currency:'TRY'});info.append(price);art.append(a,info);holder.append(art)});const empty=document.querySelector('[data-favorites-empty]');if(empty)empty.hidden=holder.children.length>0})</script>
