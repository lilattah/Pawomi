<section class="wrap section-pad"><div class="two-cols">{% for block in section.blocks %}<a href="{{ block.settings.link | default: '/collections/all' }}" class="collection-tile" style="--tile:{{ block.settings.background }}" {{ block.shopify_attributes }}><div><h2>{{ block.settings.title }}</h2><p>{{ block.settings.subtitle }}</p><span class="pill">Ürünleri İncele →</span></div>{% if block.settings.image %}{{ block.settings.image | image_url: width: 620 | image_tag: loading: 'lazy' }}{% else %}<span class="tile-emoji">{{ block.settings.emoji }}</span>{% endif %}</a>{% endfor %}</div></section>{% schema %}{"name":"Pawomi koleksiyon kartları","blocks":[{"type":"tile","name":"Koleksiyon kartı","settings":[{"type":"text","id":"title","label":"Başlık"},{"type":"text","id":"subtitle","label":"Açıklama"},{"type":"text","id":"emoji","label":"Geçici görsel"},{"type":"color","id":"background","label":"Arka plan","default":"#FFE1D9"},{"type":"url","id":"link","label":"Koleksiyon bağlantısı"},{"type":"image_picker","id":"image","label":"Görsel"}]}],"presets":[{"name":"Pawomi koleksiyon kartları","blocks":[{"type":"tile","settings":{"title":"Köpek Koleksiyonu","subtitle":"Enerjik dostlar için konfor ve stil.","emoji":"🐕","background":"#FFC7C1"}},{"type":"tile","settings":{"title":"Kedi Koleksiyonu","subtitle":"Meraklı patiler için rahat ve güvenli ürünler.","emoji":"🐈","background":"#C8E7FA"}}]}]}{% endschema %}