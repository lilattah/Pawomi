<section class="wrap section-pad"><div class="product-detail"><div class="product-gallery">{% if product.media.size > 0 %}{% for media in product.media %}{% if media.media_type == 'image' %}{{ media | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% endif %}{% endfor %}{% else %}<div class="product-photo placeholder-icon">🐾</div>{% endif %}</div><div class="product-summary"><p class="eyebrow">PAWOMI / PATİLİ SEÇİMLER</p><h1>{{ product.title }}</h1><p class="product-price">{{ product.selected_or_first_available_variant.price | money }}</p><div class="rte">{{ product.description }}</div>{% form 'product', product, class: 'buy-form' %}{% unless product.has_only_default_variant %}<label for="variantId">Seçenek</label><select name="id" id="variantId">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="quantity">Adet</label><input type="number" id="quantity" name="quantity" min="1" value="1"><button class="btn" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Sepete Ekle →{% else %}Tükendi{% endif %}</button>{% endform %}<details open><summary>Ürün detayları</summary>{{ product.description }}</details><details><summary>Beden ve ölçü rehberi</summary><p>Doğru beden için evcil hayvanınızın ölçülerini kontrol edin.</p><a href="/pages/beden-rehberi">Ölçü rehberini aç →</a></details><details><summary>Kargo ve iade</summary><a href="/pages/kargo-iade">Detayları incele →</a></details></div></div></section>{% schema %}{"name":"Pawomi ürün detayı","settings":[]}{% endschema %}