<section class="wrap section-pad"><div class="page-heading"><p class="eyebrow">PATİLİ İLHAMLAR</p><h1>{{ blog.title }}</h1><p>Mutlu patiler için rehberler, fikirler ve hikâyeler.</p></div>{% paginate blog.articles by 9 %}<div class="blog-grid">{% for article in blog.articles %}<a href="{{ article.url }}" class="blog-card">{% if article.image %}{{ article.image | image_url: width: 680 | image_tag: loading: 'lazy' }}{% else %}<div class="placeholder-icon">🐕 🐈</div>{% endif %}<div><p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p><span>Devamını oku →</span></div></a>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>{% schema %}{"name":"Pawomi blog","settings":[]}{% endschema %}