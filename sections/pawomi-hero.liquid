<section class="hero red-section" data-game-base="{{ 'pawomi-game-dog.png' | asset_url | split: 'pawomi-game-dog.png' | first }}"><div class="wrap hero-grid"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading | newline_to_br }}</h1><p>{{ section.settings.subtitle }}</p><a class="btn cream-btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_text }} →</a></div><div class="hero-visual">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager' }}{% else %}<div class="pawomi-hero-pair"><img src="{{ 'pawomi-dog.png' | asset_url }}" alt="Neşeli benekli köpek" width="490" height="350" loading="eager"><img src="{{ 'pawomi-cat.png' | asset_url }}" alt="Yün topuyla oynayan kedi" width="420" height="320" loading="eager"></div>{% endif %}<span class="hero-bubble">Mutlu Patiler<br>Güzel Yarınlar ♡</span></div></div></section>{% schema %}{"name":"Pawomi ana banner","settings":[{"type":"text","id":"eyebrow","label":"Üst başlık","default":"PATİLİ DOSTLAR İÇİN"},{"type":"textarea","id":"heading","label":"Ana başlık","default":"DAHA MUTLU
YARINLAR"},{"type":"text","id":"subtitle","label":"Açıklama","default":"Onların mutluluğu, bizim ilhamımız."},{"type":"text","id":"button_text","label":"Buton metni","default":"Alışverişe Başla"},{"type":"url","id":"button_link","label":"Buton bağlantısı"},{"type":"image_picker","id":"image","label":"Banner görseli"}],"presets":[{"name":"Pawomi ana banner"}]}{% endschema %}