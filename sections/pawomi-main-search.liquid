<section class="wrap section-pad"><div class="page-heading"><h1>Arama Sonuçları</h1><form action="{{ routes.search_url }}" method="get" class="searchbar"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Ne arıyorsun?" required><input type="hidden" name="type" value="product"><button type="submit" class="btn">Ara</button></form></div>{% if search.performed %}{% paginate search.results by 12 %}<p>“{{ search.terms | escape }}” için {{ search.results_count }} sonuç</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'pawomi-product-card', product: item %}{% endif %}{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</section>{% schema %}{"name":"Pawomi arama","settings":[]}{% endschema %}